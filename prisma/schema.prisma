datasource db {
  provider = "sqlite"
  // Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in
  // lib/prisma-adapter.ts (runtime, per site). Same file: data/app.db.
}

generator client {
  // Rust-free client generated as TypeScript inside the app tree.
  // moduleFormat/importFileExtension are pinned to what Next, Jest and tsx
  // all resolve: CommonJS globals + extensionless relative imports.
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

model User {
  id        String   @id @default(cuid())
  /// Full display name, e.g. 'سارا محمدی' — one field, as entered by the customer.
  name      String
  /// Null for customers who sign up with a phone number only.
  email     String?  @unique
  /// Iranian mobile number, e.g. '09121234567' — the customer's username.
  phone     String?  @unique
  /// 'admin' | 'member' | 'customer' — checked by lib/api-auth.ts before any write.
  role      String   @default("member")
  salt      String
  /// PBKDF2-SHA256(password, salt) as lowercase hex — see lib/users.ts.
  passwordHash String
  /// SHA-256 hex of the password-reset code, salted with the user salt —
  /// never the code itself. Null when no reset is in flight.
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  /// 'password' | 'twostep' | 'otp' — the user's own sign-in method (profile
  /// setting). The admin's site-wide policy (AppSettings.loginPolicy) can
  /// force 'twostep'/'otp' for everyone, overriding this value.
  loginMethod        String   @default("password")
  /// While a two-step/OTP login is pending: SHA-256 of the 6-digit code,
  /// salted with the user salt. Null when nothing is pending.
  loginCodeHash      String?
  /// SHA-256 of the pending login ticket — the opaque handle the OTP step
  /// presents instead of re-sending credentials. Null when nothing is pending.
  loginTicketHash    String?
  loginCodeExpiresAt DateTime?
  /// National ID code (کد ملی) — matched against the mobile number via the
  /// Shahkar service at signup, when the admin enabled it (تنظیمات → شاهکار).
  nationalId         String?
  /// True when the admin blocked the account (مشتریان → مسدود کردن): sign-in
  /// is refused until it is lifted. Staff accounts are managed from /users.
  isBlocked          Boolean  @default(false)
  /// Wallet balance in Toman — online payments land here first, orders are
  /// then paid from it. Mirrors the WalletTransaction ledger.
  walletBalance Int      @default(0)
  /// Saved delivery addresses — chosen from during checkout.
  addresses Address[]
  walletTransactions          WalletTransaction[]
  onlinePaymentTransactions   OnlinePaymentTransaction[]
  /// Coupons assigned specifically to this customer (null on Coupon = public).
  coupons Coupon[]
  /// Single-use-per-customer record of burned coupons.
  couponRedemptions CouponRedemption[]
  /// تیکت‌های پشتیبانی مشتری با مالک فروشگاه — همان الگوی تیکتینگ پنل Core.
  supportTickets SupportTicket[]
  /// درخواست‌های مرجوعی کالا که همین مشتری ثبت کرده است.
  returnRequests ReturnRequest[]
  /// لیست علاقه‌مندی‌های مشتری — یکی به‌ازای هر محصول نشان‌شده.
  favorites Favorite[]
  createdAt DateTime @default(now())
}

/// تیکت پشتیبانی مشتری↔مالک فروشگاه — واژه‌نامه مرجع (open|answered|closed)
/// و قاعده نخوانده مشتق از timestampها (هرگز شمارنده). مهمان‌ها بدون حساب و
/// با توکن کوکی mnt_support تیکت می‌زنند؛ userId برای آن‌ها null است.
model SupportTicket {
  id        String   @id @default(cuid())
  /// شناسه انسانی «TK-#####» — تولید با retry برخورد؛ در چت و جدول پنل نمایش داده می‌شود.
  displayId String   @unique
  /// null = تیکت مهمان (شناسایی با guestToken کوکی mnt_support).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// شناسایی خوداظهاری مهمان — قبل از اولین پیام الزامی است (قاعده مرجع).
  guestName  String?
  guestPhone String?
  /// توکن opaque قابلیت مهمان — مقدار کوکی mnt_support.
  guestToken String? @unique
  /// موضوع مهمان از دل اولین پیامش ساخته می‌شود (۶۰ نویسه اول).
  subject   String
  /// 'open' (در انتظار پاسخ) | 'answered' | 'closed' — قفل بسته فقط با اکشن پشتیبان باز می‌شود.
  status    String   @default("open")
  /// آخرین پیام رشته — مرتب‌سازی لیست‌ها بر همین اساس است.
  lastMessageAt DateTime @default(now())
  /// سمت نویسنده آخرین پیام — 'customer' | 'owner'.
  lastMessageAuthor String @default("customer")
  /// آخرین بازدید درخواست‌کننده (null = هرگز) — ورودی قاعده نخوانده.
  customerReadAt DateTime?
  /// آخرین بازدید پشتیبان (null = هرگز).
  staffReadAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  SupportTicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([lastMessageAt])
}

/// پیام‌های تیکت مشتری↔مالک — authorSide 'customer' یا 'owner'.
model SupportTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorSide String
  authorName String
  body       String
  /// تصویر پیوست اختیاری — مسیر نسبی uploads/ (فقط JPG/PNG، سقف ۲۰۰KB در
  /// آپلود اعمال می‌شود)؛ سرو با GET /api/files/:path…
  imagePath  String?
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

/// A saved delivery address of a customer, managed from the checkout flow.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Short label, e.g. 'خانه' or 'محل کار'.
  title     String
  /// Who receives the parcel at this address.
  receiverName  String
  receiverPhone String
  /// Full address text (city, street, number, unit…).
  body      String
  postalCode String?
  createdAt DateTime @default(now())
}

/// Key-value store for admin-editable panel settings (payment/SMS keys…).
model AppConfig {
  key   String @id
  value String
}

/// Admin-defined role (نقش). The machine name is what User.role stores; a
/// role with isAdmin = true signs in with full admin access, everything else
/// is staff (member-level). The three built-ins — admin, member, customer —
/// are referenced by code and can be retitled but not deleted.
model Role {
  id String @id @default(cuid())
  /// Machine name stored on User.role — lowercase latin/digits/dash.
  name String @unique
  /// Persian display title shown in the admin UI.
  title String
  /// Full admin access when true; otherwise staff-level like 'member'.
  isAdmin Boolean @default(false)
  /// JSON array of permission entries (lib/nav-permissions.ts): a bare href
  /// grants view, `href:edit` / `href:add` grant the write actions.
  /// Ignored for isAdmin roles — they see everything.
  permissions String @default("[]")
  /// Display-only group this role sits in (/role-groups) — null = ungrouped.
  groupId String?
  group   RoleGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

/// Display-only bucket that organises roles (گروه نقش‌ها، /role-groups) —
/// grants no permissions; deleting one just ungroups its roles.
model RoleGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  roles       Role[]
}

/// Site-wide storefront settings (name, contact, about us, logo, favicon,
/// enamad/رسانه badges) — a table of its own, deliberately separate from
/// AppConfig, so the whole site-settings block can be split into an
/// independent module later. Keys are the former `site_*` appConfig keys.
model SiteSetting {
  key   String @id
  value String
}

/// Saved customization of one storefront theme — palette + section toggles,
/// stored as a validated JSON string. One row per theme; the row with
/// active = true is the live skin (enforced single-active by lib code).
model ThemeConfig {
  /// 'beautyshop' | 'digimarket' | 'digishop' | 'softkala'
  themeId String @id
  /// JSON of { colors, sections } — validated by lib/theme-settings.ts.
  config  String
  active  Boolean @default(false)
  updatedAt DateTime @updatedAt
}

/// Injectable third-party snippet ("meta code") — Google Analytics, Tag
/// Manager, Search Console verification… Content is validated per kind in
/// lib/meta-tags.ts (IDs and allowlisted tags only — no arbitrary scripts),
/// so a malicious payload can never be stored or rendered.
model MetaTag {
  id String @id @default(cuid())
  /// Slot kind — see META_TAG_KINDS in lib/meta-tags.ts:
  /// 'ga4' | 'gtm' | 'gsc' | 'clarity' | 'custom'
  kind    String
  /// Admin-facing label shown in the settings list.
  title   String
  /// The validated snippet/identifier, rendered into <head>.
  content String
  isActive Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Admin-defined product group or category, e.g. 'موبایل' → 'گوشی ساده'.
/// A root row (parent = null) is a group; children are its categories.
model Category {
  id     String   @id @default(cuid())
  name   String
  slug   String   @unique
  /// Parent category — null = top-level group.
  parentId String?
  parent   Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]  @relation("CategoryTree")
  sortOrder Int     @default(0)
  /// Coupons restricted to this category's products.
  coupons Coupon[]
  products ProductCategory[]
  /// JSON string of { themeId: [sectionId, …] } — which storefront sections
  /// (of the ACTIVE theme) this group/category is pinned to. Empty = show
  /// everywhere (SQLite has no native Json column).
  placements String @default("{}")
  createdAt DateTime @default(now())
}

/// Product ↔ category assignment (a product can live in several categories).
model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  /// URL-safe unique identifier, derived from the (Persian) name.
  slug      String   @unique
  /// Base price in Toman, before the discount below.
  price     Int
  /// Discount percent off the price (0–90), applied to the product and its
  /// variants alike. 0 = no discount.
  discountPercent Int @default(0)
  /// موجودی کل — برای کالای بدون نوع، همان موجودی قابل فروش است؛ برای کالای
  /// نوع‌دار همیشه = جمع qty نوع‌ها (کسر/برگشت ثبت سفارش هر دو را هم‌زمان
  /// در همان تراکنش به‌روز می‌کند؛ فرم محصول هم آن را مشتق می‌کند).
  qty       Int      @default(0)
  isVisible Boolean  @default(true)
  /// JSON string of [{ key, value }] — SQLite has no native Json column.
  props     String   @default("[]")
  /// JSON string of { themeId: [sectionId, …] } — which storefront sections
  /// (of the ACTIVE theme) this product is pinned to; its categories' pins
  /// add to this. Empty = show everywhere.
  placements String @default("{}")
  variants  ProductVariant[]
  images    ProductImage[]
  categories ProductCategory[]
  /// نقطه سفارش — رسیدن موجودی به این مقدار هشدار «لیست خرید» می‌دهد.
  reorderPoint Int?
  /// حداقل موجودی — رسیدن به این مقدار یا کمتر هشدار «رو به اتمام» می‌دهد.
  minStock Int?
  /// خالی‌فروشی این کالا — فقط با مجوز پنل Core (سقف کل فروشگاه برقرار است).
  oversellAllowed Boolean @default(false)
  /// حداکثر تعداد خالی‌فروشی مجاز برای همین کالا (۱ تا سقف دامنه).
  oversellMax Int?
  /// Batch price updates that touched this product — see PriceChange.
  priceChanges PriceChange[]
  /// Coupons restricted to this product only.
  coupons   Coupon[]
  /// Coupons whose eligibility requires having purchased this product.
  purchasedProductCoupons Coupon[] @relation("CouponPurchasedProduct")
  /// برند کالا — اختیاری؛ حذف برند کالا را بی‌برند نمی‌کند (SetNull).
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// مشتریانی که این کالا را علاقه‌مندی کرده‌اند.
  favorites Favorite[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
}

/// برند کالا — تعریف در بک‌آفیس فروشگاه (/brands) و فیلتر فروشگاهی /?brand=.
model Brand {
  id     String  @id @default(cuid())
  name   String
  /// URL-safe unique identifier, derived from the (Persian) name.
  slug   String  @unique
  /// لوگوی برند — مسیر نسبی data/ (مثل uploads/ab12.jpg)؛ سرو با /api/files.
  logoPath String?
  /// برند غیرفعال از فیلتر و لیست فروشگاه حذف می‌شود ولی داده می‌ماند.
  isActive Boolean @default(true)
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// علاقه‌مندی مشتری — سبد شخصی «بعداً می‌خرم»؛ یک رکورد به‌ازای هر (کاربر، کالا).
model Favorite {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

/// سوال متداول فروشگاه — مدیریت در /settings/faq و نمایش عمومی در /faq.
model FaqEntry {
  id       String  @id @default(cuid())
  question String
  answer   String
  /// ترتیب نمایش — کوچک‌تر اول.
  sortOrder Int    @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String?
  /// Null means "inherits the product price".
  price     Int?
  qty       Int      @default(0)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Path relative to data/ — e.g. 'uploads/ab12cd.jpg'. Served by /api/files.
  path      String
  sortOrder Int     @default(0)
}

model Order {
  id        String @id @default(cuid())
  /// Human-facing ID kept for the monospace column, e.g. 'ORD-72411'.
  displayId String @unique
  customer  String
  /** Pre-formatted Jalali date string — pure string work, hydration-safe. */
  date      String
  amount    Int
  /** 'paid' | 'pending' | 'boxing' | 'posted' | 'shipped' | 'delivered' | 'cancelled' */
  status    String
  /// Category label used by the dashboard category chart.
  category  String
  /// List-price total (qty × pre-discount price) at order time — the
  /// accounting page's "original price". 0 = legacy row placed before this
  /// column existed (fall back to amount).
  baseAmount Int @default(0)
  /** Jalali month label, e.g. 'اسفند' — groups the revenue chart series. */
  month     String
  /// Customer account that placed the order — null for seeded demo rows.
  userId    String?
  /// JSON of ordered line items: [{ productId, variantId, name, qty, unitPrice }]
  itemsJson String @default("[]")
  /// 'tipax' — set when the customer starts checkout.
  deliveryMethod String?
  /// Address snapshot at checkout time (title, receiver, phone, body, postal code).
  deliveryAddress String?
  /// Gateway authority (ZarinPal) of the in-flight/last payment for this order.
  paymentAuthority String? @unique
  /// Gateway reference number after a successful verify.
  paymentRefId String?
  /// Coupon code applied at checkout (if any).
  couponCode String?
  /// Toman knocked off by the applied coupon — the payable amount is
  /// amount − discountAmount + shippingCost.
  discountAmount Int @default(0)
  /// Shipping cost added to the payable amount at checkout — 0 for
  /// pay-on-delivery (پس‌کرایه) methods, whose cost is settled at handover
  /// instead of on the invoice.
  shippingCost Int @default(0)
  /// Courier tracking code entered by the admin when posting the order.
  trackingCode String?
  /// Delivery date the admin promised the customer when posting the order.
  estimatedArrival DateTime?
  /// When the shipping-notice SMS was last sent to the customer.
  notifiedAt  DateTime?
  /// When the online payment was verified.
  paidAt    DateTime?
  /// When the order was actually handed to the customer — the anchor of the
  /// return window (مرجوعی). Null for orders delivered before this column
  /// existed (fall back to paidAt).
  deliveredAt DateTime?
  /// Random capability token for the shareable payment-link page (/pay/{token})
  /// — null until the customer shares the order's payment link.
  paymentToken String? @unique
  /// خالی‌فروشی: این سفارش شامل خط فروخته‌شده بدون موجودی است.
  oversell Boolean @default(false)
  /// مجموع تعداد واحدهای فروخته‌شده بدون موجودی در این سفارش.
  oversellQty Int @default(0)
  /// آخرین پیام فروشگاه به مشتری روی همین سفارش (علت لغو، توضیح حذف قلم…)
  /// — در کارت سفارشِ مشتری نمایش داده می‌شود.
  shopNote String?
  /// زمان ثبت آخرین پیام فروشگاه.
  shopNoteAt DateTime?
  /// تحویل حضوری — نقطه مراجعه رزروشده (null برای سفارش‌های ارسالی).
  pickupLocationId String?
  /// تحویل حضوری — بازه زمانی رزروشده.
  pickupSlotId String?
  /// تحویل حضوری — تاریخ رزرو به ISO yyyy-mm-dd (مبنای ظرفیت و فیلتر «امروز»).
  pickupDate String?
  /// تحویل حضوری — علت آخرین تغییر تاریخ/بازه توسط مالک (null = تغییر نکرده).
  pickupChangeNote String?
  /// تحویل حضوری — زمان آخرین تغییر برنامه تحویل.
  pickupChangeAt DateTime?
  /// درخواست‌های مرجوعی این سفارش (بیشتر از یک درخواستِ فعال هم‌زمان ممنوع است).
  returns ReturnRequest[]
  createdAt DateTime @default(now())
}

/// نقطه تحویل حضوری — آدرس مراجعه مشتری (شعبه/فروشگاه) که مالک تعریف می‌کند.
model PickupLocation {
  id String @id @default(cuid())
  /// عنوان نقطه، مثل «شعبه مرکزی».
  title String
  /// نشانی کامل برای نمایش به مشتری.
  address String
  /// مختصات اختیاری برای «نزدیک شما» در چک‌اوت — null یعنی بدون موقعیت.
  lat Float?
  lng Float?
  isActive Boolean @default(true)
  slots    PickupSlot[]
  createdAt DateTime @default(now())
}

/// بازه زمانی تحویل حضوری — الگوی روزانه با ظرفیت، وابسته به یک نقطه.
model PickupSlot {
  id String @id @default(cuid())
  locationId String
  location   PickupLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// شروع بازه — دقیقه از نیمه‌شب (0..1439)، مثلاً ۵۴۰ = ۰۹:۰۰.
  startMinute Int
  /// پایان بازه — دقیقه از نیمه‌شب.
  endMinute Int
  /// تعداد قابل تحویل در این بازه در هر روز.
  capacity Int
  createdAt DateTime @default(now())
}

/// روز تعطیل تحویل حضوری — سراسری برای همه نقاط؛ رزرو در این روزها بسته است.
model PickupHoliday {
  id   String @id @default(cuid())
  /// ISO yyyy-mm-dd — یکتا.
  date String @unique
  /// توضیح اختیاری، مثل «تعطیل رسمی».
  title String @default("")
  createdAt DateTime @default(now())
}

/// One gateway/SMS failure worth showing on the admin logs page: what we
/// called, which provider failed, and the error the target API returned.
model SystemLog {
  id String @id @default(cuid())
  /// 'gateway' | 'sms' | 'shahkar' | 'access' (دسترسی و حساب‌ها) | 'order' (تغییر سفارش‌ها)
  kind String
  /// Provider name: gateway id (zarinpal, sadad…), SMS panel id (mediana…) or
  /// 'shahkar'. برای access/order رشتهٔ توصیفی کوتاه، مثل 'roles' یا 'orders'.
  provider String
  /// What we were doing: 'start' | 'verify' | 'factor' | 'notice' |
  /// 'payment_link' | 'match' | 'create' | 'update' | 'delete' | 'block' | …
  action String
  /// Persian one-liner shown in the table.
  message String
  /// Raw response/error from the target API (truncated) — the "why".
  detail String @default("")
  /// چه کسی انجام داده — نام نمایشی نشست ادمین/پرسنل؛ برای خطاهای زیرساختی خالی.
  actorName String @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

/// Ledger of every wallet movement. The balance lives on User; these rows are
/// the audit trail behind it.
model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'charge' (online top-up) | 'order_payment' | 'refund' | 'admin_adjust'
  type      String
  /// Signed Toman amount: positive credits the wallet, negative debits it.
  amount    Int
  /// Free-text context: gateway ref id, admin's reason, cancelled-order note…
  reason    String?
  /// The order this movement paid for / was refunded for.
  orderId   String?
  createdAt DateTime @default(now())
}

/// History of every payment attempt — charging the wallet or paying an order —
/// with its state, per the requirement that attempts are recorded, not just
/// successes.
model OnlinePaymentTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'wallet_charge' | 'order_payment'
  kind      String
  /// Toman the attempt is for.
  amount    Int
  /// 'pending' | 'verified' | 'failed'
  state     String   @default("pending")
  /// Which gateway the attempt went through: 'zarinpal' (also the default for
  /// pre-existing rows) | 'digipay' | 'snapppay' | 'tara'.
  gateway   String   @default("zarinpal")
  /// ZarinPal authority of the in-flight gateway payment (null for instant
  /// wallet payments, which are verified on the spot).
  authority String?  @unique
  /// DigiPay providerId — our unique purchase id, echoed back on the callback.
  providerId String?
  /// Gateway reference number after a successful verify (ZarinPal ref_id /
  /// DigiPay trackingCode).
  refId     String?
  /// شماره کارت ماسک‌شده پرداخت‌کننده از پاسخ verify (وقتی درگاه بفرستد).
  cardPan   String?
  /// JSON کامل اطلاعات تأیید درگاه (کارمزد، نوع کارمزد، …) برای نمایش تراکنش.
  verifyPayload String?
  /// The order being paid, when the attempt belongs to one.
  orderId   String?
  createdAt DateTime @default(now())
}

/// Admin-defined delivery method (روش ارسال) selectable at checkout.
model ShippingMethod {
  id String @id @default(cuid())
  name String
  /// Short explanation shown under the method at checkout.
  description String @default("")
  /// 'courier' (ارسال با پست/پیک) | 'pickup' (تحویل حضوری — وابسته به یک نقطه)
  kind String @default("courier")
  /// نقطه تحویل حضوری این روش — فقط برای kind='pickup' معنا دارد.
  pickupLocationId String?
  /// حداقل زمان ارسال — روز.
  minDeliveryDays Int @default(1)
  /// حداقل هزینه ارسال — تومان.
  minShippingCost Int @default(0)
  /// هزینه ارسال در فاکتور محاسبه می‌شود؛ false = پس‌کرایه (هزینه هنگام
  /// تحویل از مشتری گرفته می‌شود و در فاکتور نمی‌آید).
  isInvoiced Boolean @default(true)
  /// Inactive methods stay in the admin list but disappear from checkout.
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
}

/// Admin-created discount code applied by the customer at checkout.
model Coupon {
  id        String    @id @default(cuid())
  /// The code the customer types, e.g. 'WELCOME10'.
  code      String    @unique
  /// 'percent' | 'fixed'
  type      String
  /// Percent (0–100) for percent coupons, Toman for fixed ones.
  value     Int
  isActive  Boolean   @default(true)
  /// Null = no expiry.
  expiresAt DateTime?
  /// Null = unlimited uses.
  maxUses   Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())
  /// Purchase floor in Toman — the coupon only applies above this (null = none).
  minPurchaseAmount Int?
  /// The single product the coupon is restricted to (null = any product).
  productId String?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// The product whose prior purchase makes the coupon eligible — the
  /// purchased-product window below applies to this product.
  purchasedProductId String?
  purchasedProduct   Product? @relation("CouponPurchasedProduct", fields: [purchasedProductId], references: [id], onDelete: SetNull)
  /// Eligibility window: only customers who already purchased the product
  /// above between purchasedFrom/purchasedTo (null = no window).
  purchasedFrom DateTime?
  purchasedTo   DateTime?
  /// Assigned to one customer (null = public coupon).
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Category restriction (null = any category).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// 'gt' | 'lt' | 'eq' — the customer's total past paid purchases must
  /// compare true against purchaseTotalAmount for the coupon to apply.
  purchaseTotalOperator String?
  /// Threshold in Toman for purchaseTotalOperator (null = rule inactive).
  purchaseTotalAmount   Int?
  /// Redemptions — one row per customer per coupon (single use each).
  redemptions CouponRedemption[]

  @@index([code])
}

/// One burned (used) coupon-code redemption by a customer — the
/// single-use-per-customer rule's ledger.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

/// History of batch price updates — one row per product/variant whose price
/// actually moved in a batch. Sold invoices are NEVER rewritten: Order.itemsJson
/// snapshots each line's unitPrice at order time, so accounting is safe by
/// construction; this table is the audit trail of what the admin changed and
/// when. variantId carries no FK on purpose — editing a product replaces its
/// variant rows, and the history must survive that churn.
model PriceChange {
  id        String   @id @default(cuid())
  /// Every product changed by one admin action shares the batch id.
  batchId   String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The variant whose explicit price changed — null = the product's own price.
  variantId String?
  /// Display label of the variant («رنگ: آبی») — kept denormalised because
  /// variant rows are deleted and recreated on product edits.
  variantName String?
  oldPrice  Int
  newPrice  Int
  /// 'category' | 'product' — what the admin targeted with the batch.
  scope     String
  /// Persian label of the target (group/category/product name) — readable
  /// even after the target itself is deleted.
  targetName String
  /// 'fixed' (Toman added) | 'percent' (percent of price added).
  adjustType String
  /// Toman for 'fixed', percent for 'percent' — as requested, can be negative.
  adjustValue Int
  /// Display name of the admin who applied the batch.
  actorName String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([productId])
}

/// درخواست مرجوعی کالا — مشتریِ سفارش تحویل‌شده ثبت می‌کند (علت + عکس +
/// انتخاب اقلام)، مالک بررسی/تایید می‌کند و پس از دریافت کالا مبلغ به کیف
/// پول مشتری واریز می‌شود. مبالغ و وضعیت‌ها فقط سمت سرور تغییر می‌کنند.
model ReturnRequest {
  id String @id @default(cuid())
  /// Human-facing ID kept for the monospace column, e.g. 'RET-72411'.
  displayId String @unique
  /// سفارشِ مبنا — در UI پنل با displayId سفارش آدرس‌دهی می‌شود.
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// مشتری درخواست‌دهنده — مالکیت رکورد در همه مسیرهای مشتری چک می‌شود.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'requested' | 'approved' | 'sent' | 'received' | 'refunded'
  /// | 'rejected' | 'cancelled' — lib/product-returns.ts
  status String @default("requested")
  /// دسته علت مرجوعی — کلیدهای RETURN_REASON_LABELS در lib/product-returns.ts.
  reasonKind String
  /// توضیح آزاد مشتری درباره علت مرجوعی.
  reason String
  /// JSON of image paths (max 3) — e.g. ["uploads/ab12cd.jpg"]، سروِ /api/files.
  imagesJson String @default("[]")
  /// JSON snapshot of returned lines: [{ productId, variantId, name, qty, unitPrice }]
  itemsJson String @default("[]")
  /// مبلغ بازگشتی اقلام (تومان) — هنگام تایید سمت سرور محاسبه و قفل می‌شود.
  refundItemsAmount Int @default(0)
  /// مبلغ نهایی واقعاً واریزشده (تومان) — در تسویه ثبت می‌شود؛ با بازگشت
  /// جزئی کمتر از refundItemsAmount + هزینه ارسال تاییدشده است. null = تسویه نشده.
  refundedAmount Int?
  /// هزینه ارسال برگشت با کیست — 'customer' | 'shop'؛ در تایید تعیین می‌شود.
  shippingPayer String?
  /// روش برگشت — 'self_ship' | 'shop_courier' | 'in_person'؛ در تایید تعیین
  /// می‌شود و برای سفارش تحویل حضوری همیشه 'in_person' است.
  returnMethod String?
  /// یادداشت مالک در تایید — پیام راهنما به مشتری (روش برگشت و غیره).
  approvalNote String?
  /// کد رهگیری مرسوله برگشتی که مشتری ثبت می‌کند (روش self_ship).
  shippingTrackingCode String?
  /// هزینه ارسال برگشت اعلامی مشتری (تومان) — فقط روش self_ship.
  shippingCost Int?
  /// عکس رسید مرسوله — مسیر نسبی data/ مانند ProductImage.path.
  shippingReceiptPath String?
  /// علت رد توسط مالک (وضعیت rejected) — در تایم‌لاین مشتری نمایش داده می‌شود.
  rejectReason String?
  approvedAt  DateTime?
  sentAt      DateTime?
  receivedAt  DateTime?
  refundedAt  DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime @default(now())
  events      ReturnEvent[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

/// رویدادهای تایم‌لاین مرجوعی — منبع نمایش مراحل برای مشتری و مالک فروشگاه.
model ReturnEvent {
  id String @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  /// کد وضعیت پس از رویداد ('requested' | 'approved' | … | 'note').
  toStatus String
  /// متن فارسی رویداد برای تایم‌لاین.
  message String
  /// 'customer' | 'staff' — چه کسی رویداد را ثبت کرد.
  actorRole String
  /// نام نمایشی ثبت‌کننده.
  actorName String
  createdAt DateTime @default(now())

  @@index([returnRequestId])
}
