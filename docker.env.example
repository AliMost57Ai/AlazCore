# ─────────────────────────────────────────────────────────────────────────────
# متغیرهای محیطی اجرای Docker (هر دو container) — پیکربندی production
# این فایل را به docker.env کپی کنید و سه کلید تصادفی را پر کنید:
#     cp docker.env.example docker.env
# این فایل سکرت دارد و کامیت نمی‌شود (در .gitignore هست).
# تولید هر کلید:  openssl rand -base64 32
#
# توجه: دامنه‌ی هر سایت در production از هدر Host درخواست خوانده می‌شود —
# nginx باید `proxy_set_header Host $host;` بگذارد (بنگر DEPLOY.md §7).
# متغیر SHOP_DOMAIN مخصوص توسعه/تست محلی است و در این فایل جایی ندارد.
# ─────────────────────────────────────────────────────────────────────────────

# کلید امضای کوکی نشست فروشگاه — اجباری (حداقل ۱۶ نویسه)
AUTH_SECRET=

# کلید امضای کوکی نشست پنل Core — اجباری (حداقل ۱۶ نویسه)
CORE_AUTH_SECRET=

# کلید API مشترک بین فروشگاه و پنل Core — اجباری
# (اعتبارسنجی لایسنس فروشگاه‌ها + API گزارشات؛ یک مقدار تصادفی کافی است)
CORE_API_KEY=

# ─── آدرس‌دهی داخل شبکه Docker — این دو را تغییر ندهید ───────────────────────
# (اسم سرویس‌ها در compose به‌عنوان hostname کار می‌کند)
CORE_API_URL=http://core:3100
SHOP_API_URL=http://shop:3000

# وقتی سرویس Core در دسترس/پیکربندی نبود چه بشود؟
# closed (پیش‌فرض و قرارداد محصول) = هیچ سایتی بدون تأیید کور لود نمی‌شود
# open = حالت اضطراری — سایت باز می‌ماند و فقط لاگ می‌شود
CORE_FAIL_MODE=closed

# طول کش لایسنس هر دامنه (ثانیه) — پیش‌فرض 900 (۱۵ دقیقه). تعلیق/انقضای
# دامنه حداکثر همین بازه بعد در فروشگاه اعمال می‌شود.
# LICENSE_CACHE_TTL_SEC=900

# بوت اول روی volume خالی: داده دمو + حساب ادمین seed شود؟
# production پیشنهاد: false (دیتای دمو نخواهید داشت؛ ادمین هر دامنه را
# خود پنل Core هنگام ثبت دامنه می‌سازد)
SEED_ON_FIRST_BOOT=false

# منطقه زمانی containerها — نمایش ساعت‌ها مطابق سیستم توسعه
TZ=Asia/Tehran
