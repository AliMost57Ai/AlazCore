{
  "name": "mantine-next-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint .",
    "stylelint": "stylelint \"**/*.css\" --cache",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "npx next typegen && npm run prettier:check && npm run lint && npm run typecheck && npm run jest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:site-migration": "tsx scripts/new-site-migration.ts",
    "db:migrate-sites": "tsx scripts/migrate-sites.ts",
    "db:migrate-uploads": "tsx scripts/migrate-site-uploads.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mantine/core": "^8.3.7",
    "@mantine/dates": "^8.3.7",
    "@mantine/dropzone": "^8.3.7",
    "@mantine/form": "^8.3.7",
    "@mantine/hooks": "^8.3.7",
    "@mantine/modals": "^8.3.7",
    "@mantine/notifications": "^8.3.7",
    "@mantine/nprogress": "^8.3.7",
    "@next/bundle-analyzer": "^16.4.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tabler/icons-react": "^3.35.0",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "jalaali-js": "^2.0.1",
    "jalaliday": "^3.1.1",
    "jose": "^6.2.12",
    "next": "^16.4.2",
    "prisma": "^7.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.37.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/nextjs": "^10.6.2",
    "@storybook/react": "^10.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.1",
    "@types/react": "19.2.2",
    "babel-loader": "^10.0.0",
    "baseline-browser-mapping": "^2.11.23",
    "eslint": "^9.37.0",
    "eslint-config-mantine": "^4.0.3",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.6.2",
    "storybook": "^10.6.2",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "yarn@4.11.0",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261002.1": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@12.11.1": true
  }
}
