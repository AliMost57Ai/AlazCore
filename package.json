{
  "name": "mantine-next-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/check-native.cjs",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "prestart": "node scripts/check-native.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint .",
    "stylelint": "stylelint \"**/*.css\" --cache",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "npx next typegen && npm run prettier:check && npm run lint && npm run typecheck && npm run jest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:site-migration": "tsx scripts/new-site-migration.ts",
    "db:migrate-sites": "tsx scripts/migrate-sites.ts",
    "db:migrate-uploads": "tsx scripts/migrate-site-uploads.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/dates": "^9.8.0",
    "@mantine/dropzone": "^9.8.0",
    "@mantine/form": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@mantine/nprogress": "^9.8.0",
    "@next/bundle-analyzer": "^16.4.6",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tabler/icons-react": "^3.51.0",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "jalaali-js": "^2.0.1",
    "jalaliday": "^3.1.1",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/nextjs": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "babel-loader": "^10.1.1",
    "baseline-browser-mapping": "^2.11.35",
    "eslint": "^9.39.5",
    "eslint-config-mantine": "^3.2.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^25.1.0",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.7",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^7.3.1"
  },
  "packageManager": "yarn@4.11.0",
  "overrides": {
    "better-sqlite3": "^13.0.3",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261002.1": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@13.0.3": true
  }
}
