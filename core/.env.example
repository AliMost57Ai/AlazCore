# ─────────────────────────────────────────────────────────────────────────────
# پنل Core (SuperAdmin) — تنظیمات محیطی
# این فایل را به ‎.env‎ کپی کنید و مقادیر را پر کنید.
# ─────────────────────────────────────────────────────────────────────────────

# کلید امضای کوکی نشست پنل Core (اجباری در پروداکشن؛ حداقل ۱۶ نویسه).
# تولید نمونه:  openssl rand -base64 32
CORE_AUTH_SECRET=

# کلید API که فروشگاه‌ها با آن سرویس اعتبارسنجی لایسنس را صدا می‌زنند
# (هدر x-core-key روی POST /api/validate). در پنل، صفحه تنظیمات هم قابل تولید است.
CORE_API_KEY=

# مسیر ریشه‌ی اپ فروشگاه برای پروویژن دیتابیس سایت‌ها (پوشه/فایل دیتابیس هر
# دامنه هنگام ثبت در همین مسیر ساخته می‌شود). پیش‌فرض: پوشه‌ی والد اپ Core.
# SHOP_APP_ROOT=..

# آدرس API فروشگاه برای همه تبادل‌های دیتا (گزارشات سایت‌ها، قاعده در-حال-
# استفاده و…) — خواندن مستقیم دیتابیس سایت‌ها ممنوع است.
# SHOP_API_URL=http://127.0.0.1:3000
