{
  "name": "alazcore-core-panel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "predev": "node scripts/check-native.cjs",
    "build": "next build",
    "start": "next start -p 3100",
    "prestart": "node scripts/check-native.cjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mantine/core": "^8.3.7",
    "@mantine/form": "^8.3.7",
    "@mantine/hooks": "^8.3.7",
    "@mantine/modals": "^8.3.7",
    "@mantine/notifications": "^8.3.7",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tabler/icons-react": "^3.35.0",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "jalaali-js": "^2.0.1",
    "next": "^16.4.2",
    "prisma": "^7.10.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^24.7.1",
    "@types/react": "19.2.2",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "better-sqlite3": "^13.0.3",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
