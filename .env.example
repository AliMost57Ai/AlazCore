# ─────────────────────────────────────────────────────────────────────────────
# تنظیمات محیطی فروشگاه
# این فایل را به ‎.env‎ کپی کنید و مقادیر را پر کنید (فقط سرور تولید لازم دارد).
# ─────────────────────────────────────────────────────────────────────────────

# کلید امضای کوکی نشست (اجباری در پروداکشن).
# اگر تنظیم نشود یا کمتر از ۱۶ نویسه باشد، سرور در محیط تولید بالا نمی‌آید.
# یک بار تولید کنید و همیشه همان را نگه دارید — عوضش کردن همه نشست‌ها را
# بی‌اعتبار می‌کند (همه از حسابشان بیرون می‌روند).
# تولید نمونه:  openssl rand -base64 32
AUTH_SECRET=

# ─── اتصال به سامانه Core (پنل سوپرادمین فروشگاه‌ساز) ─────────────────────
# اگر این دو پر شوند، فروشگاه پیش از لود شدن اعتبارش را با سرویس
# /api/validate پنل Core چک می‌کند (بند ۲-۹) و هر ۱۵ دقیقه یک‌بار تجدید
# می‌کند. اگر در production خالی بمانند، سایت مسدود است (fail-closed با کد
# license:down) — «اعتبارسنجی غیرفعال» فقط در `next dev` روی localhost رخ
# می‌دهد، نه در سرور.
CORE_API_URL=http://127.0.0.1:3100
CORE_API_KEY=
# همین کلید برعکس هم استفاده می‌شود: APIهای سمت‌Core فروشگاه
# (/api/core/* از جمله /api/core/diagnostics) درخواست‌های پنل Core یا
# عیب‌یابی دستی را با هدر x-core-key = CORE_API_KEY احراز می‌کنند.

# طول کش لایسنس هر دامنه (ثانیه) — پیش‌فرض ۹۰۰ (۱۵ دقیقه). تعلیق/انقضای
# دامنه‌ی هر سایت حداکثر همین بازه بعد روی همان سایت اعمال می‌شود؛ کش
# per-domain و در حافظه‌ی همان پروسه است، پس هیچ سایتی از کش سایت دیگر
# استفاده نمی‌کند. مقدار کمتر = تغییر وضعیت سریع‌تر، فشار بیشتر روی Core.
# LICENSE_CACHE_TTL_SEC=900

# دامنه‌ی این فروشگاه — فقط توسعه/تست محلی؛ در production حتماً کامنت باشد
# (دامنه از هدر Host درخواست خوانده می‌شود). «به‌عنوان این سایت اجرا شو» —
# اعتبارسنجی لایسنس و دیتای همین دامنه لود می‌شود حتی روی localhost، پس برای
# تست با `npm start` روی localhost این را ست کنید. خالی فقط در `next dev` یعنی
# bypass و دیتابیس اصلی data/app.db؛ در `npm start` خالی یعنی صفحه‌ی تعلیق با
# کد domain (production بدون دامنه). مثل: shop140.ir
SHOP_DOMAIN=

# اگر سرویس Core در دسترس نبود چه شود:
#  - closed (production): هیچ سایتی بدون تأیید Core لود نمی‌شود.
#  - open (فقط محیط توسعه/تست): سایت باز می‌ماند و فقط لاگ می‌شود.
# توجه: این متغیر فقط «وقتی Core در دسترس نیست» را تعیین می‌کند؛ پاسخ معتبرِ
# منفیِ Core (دامنه‌ی غیرفعال/معلق/منقضی/ثبت‌نشده) در هر دو حالت سایت را
# مسدود می‌کند.
CORE_FAIL_MODE=closed
