# ─────────────────────────────────────────────────────────────────────────────
# تنظیمات محیطی فروشگاه
# این فایل را به ‎.env‎ کپی کنید و مقادیر را پر کنید (فقط سرور تولید لازم دارد).
# ─────────────────────────────────────────────────────────────────────────────

# کلید امضای کوکی نشست (اجباری در پروداکشن).
# اگر تنظیم نشود یا کمتر از ۱۶ نویسه باشد، سرور در محیط تولید بالا نمی‌آید.
# یک بار تولید کنید و همیشه همان را نگه دارید — عوضش کردن همه نشست‌ها را
# بی‌اعتبار می‌کند (همه از حسابشان بیرون می‌روند).
# تولید نمونه:  openssl rand -base64 32
AUTH_SECRET=

# ─── اتصال به سامانه Core (پنل سوپرادمین فروشگاه‌ساز) ─────────────────────
# اگر این دو پر شوند، فروشگاه پیش از لود شدن اعتبارش را با سرویس
# /api/validate پنل Core چک می‌کند (بند ۲-۹). خالی = اعتبارسنجی غیرفعال.
CORE_API_URL=http://127.0.0.1:3100
CORE_API_KEY=
# همین کلید برعکس هم استفاده می‌شود: APIهای سمت‌Core فروشگاه
# (/api/core/reports/[kind] و /api/core/integration-usage) درخواست‌های
# پنل Core را با هدر x-core-key = CORE_API_KEY احراز می‌کنند.

# دامنه‌ی این فروشگاه — فقط توسعه/تست محلی؛ در production نادیده گرفته می‌شود
# و دامنه همیشه از هدر Host درخواست خوانده می‌شود.
# «به‌عنوان این سایت اجرا شو» — اعتبارسنجی لایسنس و دیتای همین دامنه لود
# می‌شود حتی روی localhost. خالی = روی localhost اعتبارسنجی bypass و دیتابیس
# اصلی data/app.db استفاده می‌شود. مثل: shop2.ir
SHOP_DOMAIN=

# وقتی سرویس Core در دسترس نباشد: open = فروشگاه باز بماند (توسعه)،
# closed = فروشگاه مسدود شود. در production «کور پیکربندی‌نشده» هم با همین
# متغیر تصمیم می‌گیرد (قرارداد fail-closed).
CORE_FAIL_MODE=open
